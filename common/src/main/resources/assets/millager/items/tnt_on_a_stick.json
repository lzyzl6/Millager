{
	"model": {
		"type": "minecraft:select",
		"cases": [
			{
				"when": ["gui", "ground", "fixed"],
				"model": {
					"type": "minecraft:model",
					"model": "millager:item/tnt_on_a_stick"
				}
			},
			{
				"when": ["thirdperson_righthand", "thirdperson_lefthand"],
				"model": {
						"type": "minecraft:model",
						"model": "millager:item/tnt_on_a_stick_entity"
				}
			}
		],
		"fallback": {
			"type": "minecraft:condition",
			"on_false": {
				"type": "minecraft:model",
				"model": "millager:item/tnt_on_a_stick_entity"
			},
			"on_true": {
				"type": "minecraft:model",
				"model": "millager:item/tnt_on_a_stick_throwing"
			},
			"property": "minecraft:using_item"
		},
		"property": "minecraft:display_context"
	}
}
