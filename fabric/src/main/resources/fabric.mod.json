{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "enesbaskaya26",
        "asdf357802",
        "tyjz73"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/millager",
        "issues": "https://github.com/lzyzl6/Millager/issues"
    },
    "license": "${license}",
    "icon": "assets/millager/icon.png",
    "environment": "*",
    "accessWidener": "${mod_id}.accesswidener",
    "entrypoints": {
        "main": [
            "org.lzyzl.millager.MillagerFabric"
        ],
        "client": [
            "org.lzyzl.millager.client.MillagerFabricClient"
        ],
        "modmenu": [
            "org.lzyzl.millager.client.MillagerModMenu"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": "*"
    }
}
